    {
      "parameters": {
        "jsCode": "const client = $('Code in JavaScript').first().json;\nconst classification = $('AI Agent').first().json.output;\n\nreturn [\n  {\n    json: {\n      client_name: client.client_name,\n      company_name: client.company_name,\n      email: client.email,\n      service_required: client.service_required,\n      project_description: client.project_description,\n      budget: client.budget,\n\n      service_category: classification.service_category,\n      priority: classification.priority,\n      summary: classification.summary,\n      next_action: classification.next_action\n    }\n  }\n];"
      },
