    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    c.customer_id,\n    c.full_name AS name,\n    c.phone,\n    c.email,\n    c.city,\n    c.customer_status,\n    MAX(\n        COALESCE(m.created_at, cv.started_at, a.created_at)\n    ) AS last_interaction\nFROM customers c\nLEFT JOIN conversations cv\n    ON c.customer_id = cv.customer_id\nLEFT JOIN messages m\n    ON cv.conversation_id = m.conversation_id\nLEFT JOIN activities a\n    ON c.customer_id = a.customer_id\nGROUP BY\n    c.customer_id,\n    c.full_name,\n    c.phone,\n    c.email,\n    c.city,\n    c.customer_status\nORDER BY c.created_at;",
        "options": {}
      },
