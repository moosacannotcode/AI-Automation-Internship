        "operation": "executeQuery",
        "query": "SELECT\n    l.lead_id,\n    c.full_name AS customer,\n    c.phone,\n    p.product_name AS product,\n    l.budget,\n    c.city AS location,\n    l.purchase_intent,\n    l.lead_source,\n    l.priority,\n    l.lead_status,\n    l.assigned_to,\n    l.next_follow_up,\n    l.notes\nFROM leads l\nJOIN customers c\n    ON l.customer_id = c.customer_id\nLEFT JOIN products p\n    ON l.product_id = p.product_id\nORDER BY l.created_at;",
