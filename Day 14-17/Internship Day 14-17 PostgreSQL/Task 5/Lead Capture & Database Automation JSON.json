    {
      "parameters": {
        "jsCode": "const lead = $json.body;\n\nconst requiredFields = [\n  'name',\n  'email',\n  'phone',\n  'company',\n  'source',\n  'message'\n];\n\nconst missingFields = requiredFields.filter(\n  field => !lead[field] || String(lead[field]).trim() === ''\n);\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst validEmail = emailRegex.test(String(lead.email || '').trim());\n\nconst isValid = missingFields.length === 0 && validEmail;\n\nreturn [\n  {\n    json: {\n      ...lead,\n      isValid,\n      validEmail,\n      missingFields\n    }\n  }\n];"
      },
