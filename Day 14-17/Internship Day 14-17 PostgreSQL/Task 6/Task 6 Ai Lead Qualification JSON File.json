        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Lead captured and qualified successfully\",\n  \"lead_id\": \"{{$json.id}}\",\n  \"lead_score\": {{$json.lead_score}},\n  \"lead_status\": \"{{$json.lead_status}}\",\n  \"lead_category\": \"{{$json.lead_category}}\"\n}",
        "options": {}
