    {
      "parameters": {
        "jsCode": "const messages = $input.all();\n\nconst conversationHistory = messages\n  .map(item => {\n    const role = item.json.role || 'unknown';\n    const message = item.json.message || '';\n\n    return `${role.toUpperCase()}: ${message}`;\n  })\n  .join('\\n');\n\nconst conversationId = messages[0]?.json.conversation_id;\n\nconst currentMessage = $('When chat message received').first().json.chatInput;\n\nreturn [\n  {\n    json: {\n      conversationId,\n      conversationHistory,\n      currentMessage\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
